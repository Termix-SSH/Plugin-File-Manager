{
  "id": "file-manager",
  "name": "File Manager",
  "version": "1.1.1",
  "description": "Browse, edit and move files over SFTP, including straight from one server to another.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-File-Manager",
  "docs": "https://docs.termix.site/plugins/file-manager",
  "video": "https://www.youtube.com/watch?v=0JMZny47MiI",
  "category": "Files & Transfer",
  "icon": "FolderSearch",
  "features": [
    "Browse, upload, download, rename, move and delete files, with sudo support",
    "Edit files in a built-in code editor",
    "Preview images, PDFs, audio and video",
    "A trash you can restore deleted files from",
    "Copy files between two hosts, with the fastest route picked for you and an integrity check",
    "A files panel beside any SSH terminal that follows its folder, with a history of your folders",
    "A side by side local and remote view in the desktop app"
  ],
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.9"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "events:core",
    "kv:own",
    "users:impersonate",
    "desktop:local"
  ],
  "provides": [
    {
      "service": "files.sftp",
      "version": "1.0.0",
      "permission": "file-manager.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "files",
        "titleKey": "nav.files",
        "icon": "FolderSearch",
        "openFrom": ["host-context-menu", "palette"]
      },
      {
        "id": "sftp",
        "titleKey": "nav.sftp",
        "icon": "ArrowLeftRight",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "actions": [
      {
        "id": "files.openHost",
        "titleKey": "nav.files",
        "handler": "openHost",
        "permission": "file-manager.use"
      },
      {
        "id": "files.openEditor",
        "titleKey": "nav.files",
        "handler": "openEditor",
        "permission": "file-manager.use"
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "user": [
        {
          "key": "transferConcurrency",
          "type": "number",
          "labelKey": "settings.user.transferConcurrency.label",
          "descriptionKey": "settings.user.transferConcurrency.description",
          "min": 1,
          "max": 8,
          "default": 4
        },
        {
          "key": "confirmBeforeTrash",
          "type": "boolean",
          "labelKey": "settings.user.confirmBeforeTrash.label",
          "descriptionKey": "settings.user.confirmBeforeTrash.description",
          "default": true
        },
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 380
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        },
        {
          "key": "companionFollowTerminal",
          "type": "boolean",
          "labelKey": "settings.user.companionFollowTerminal.label",
          "descriptionKey": "settings.user.companionFollowTerminal.description",
          "default": true
        },
        {
          "key": "companionSyncInterval",
          "type": "number",
          "labelKey": "settings.user.companionSyncInterval.label",
          "descriptionKey": "settings.user.companionSyncInterval.description",
          "min": 1,
          "max": 30,
          "default": 3
        },
        {
          "key": "companionHistorySize",
          "type": "number",
          "labelKey": "settings.user.companionHistorySize.label",
          "descriptionKey": "settings.user.companionHistorySize.description",
          "min": 5,
          "max": 100,
          "default": 20
        }
      ],
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 60,
        "enableKey": "enableFileManager",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": true,
        "fields": [
          {
            "key": "defaultPath",
            "type": "string",
            "labelKey": "settings.host.defaultPath.label",
            "requires": "enableFileManager"
          },
          {
            "key": "scpLegacy",
            "type": "boolean",
            "labelKey": "settings.host.scpLegacy.label",
            "requires": "enableFileManager"
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableFileManager"
          }
        ]
      }
    },
    "hostCapability": {
      "key": "enableFileManager",
      "labelKey": "hostCapability.label",
      "editorTab": "plugins"
    },
    "uiPresets": {
      "simple": {
        "viewMode": "grid"
      },
      "balanced": {
        "viewMode": "grid"
      },
      "advanced": {
        "viewMode": "list"
      }
    },
    "uses": ["homepage.widgets", "host-metrics.disk", "terminal.open"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
